{
  "name": "lanzadera",
  "productName": "Lanzadera",
  "version": "1.0.0",
  "description": "Dock organizador para el escritorio de Windows 11: barra con efecto lupa, grupos, espacios de trabajo, buscador, organizador y widgets.",
  "main": "src/main/main.js",
  "author": {
    "name": "Fernando"
  },
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/fernandhinoquim-tech/lanzadera",
  "repository": {
    "type": "git",
    "url": "https://github.com/fernandhinoquim-tech/lanzadera.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.*\"",
    "gen:icons": "node scripts/gen-icon-bank.mjs",
    "dist": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "com.lanzadera.app",
    "productName": "Lanzadera",
    "copyright": "© 2026 Fernando",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/*.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/win",
        "to": "win"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Lanzadera-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lanzadera",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fernandhinoquim-tech",
        "repo": "lanzadera",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "lucide-static": "1.48.0"
  }
}
